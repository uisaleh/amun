      { "type": "number", "id": "free_shipping_threshold", "label": "Free standard shipping from ($)", "default": 150 },
      { "type": "text", "id": "ship_standard_label", "label": "Standard name", "default": "Standard" },
      { "type": "text", "id": "ship_standard_eta", "label": "Standard delivery time", "default": "5–7 business days" },
      { "type": "text", "id": "ship_standard_price", "label": "Standard price ($)", "default": "8.95" },
      { "type": "text", "id": "ship_express_label", "label": "Express name", "default": "Express" },
      { "type": "text", "id": "ship_express_eta", "label": "Express delivery time", "default": "2–3 business days" },
      { "type": "text", "id": "ship_express_price", "label": "Express price ($)", "default": "19.95" },
      { "type": "text", "id": "ship_overnight_label", "label": "Overnight name", "default": "Overnight" },
      { "type": "text", "id": "ship_overnight_eta", "label": "Overnight delivery time", "default": "Next business day" },
      { "type": "text", "id": "ship_overnight_price", "label": "Overnight price ($)", "default": "39.95" }
    ]
  },
  {
    "name": "10% signup offer",
    "settings": [
      { "type": "paragraph", "content": "Create this code in Discounts (10% off, one use per customer) so it works at checkout." },
