      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Leave empty to use the built-in icon favicon." },
      { "type": "checkbox", "id": "use_design_images", "label": "Use the Amun design photos for product cards and galleries", "default": true, "info": "Turn off to use the images saved on each product in Shopify instead." }
