      { "type": "checkbox", "id": "popup_enabled", "label": "Show the first-visit popup", "default": true },
      { "type": "range", "id": "popup_delay", "label": "Popup delay", "min": 0, "max": 15, "step": 0.5, "unit": "s", "default": 2.5 },
      { "type": "image_picker", "id": "popup_image", "label": "Popup image", "info": "Leave empty to use the meadow photo." },
      { "type": "text", "id": "popup_heading", "label": "Popup heading", "default": "Take 10% Off Your First Order" },
      { "type": "textarea", "id": "popup_text", "label": "Popup text", "default": "Join the Amun list for new formulas, rituals and launches — and get 10% off your first order." }
