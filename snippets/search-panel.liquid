<div class="overlay" data-search hidden style="z-index: 80">
  <div class="overlay__bg" data-close-search aria-hidden="true"></div>
  <div role="dialog" aria-modal="true" aria-label="Search" style="position: relative; background: #9FA383; padding: 28px 24px 36px; box-shadow: 0 1px 0 rgba(18, 18, 18, 0.15)">
    <form action="{{ routes.search_url }}" method="get" role="search" style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px">
      <div style="display: flex; align-items: center; gap: 14px">
        <label for="site-search" class="visually-hidden">Search</label>
        <div style="flex: 1 1 auto; display: flex; align-items: center; gap: 12px; border: 1px solid #121212; background: #FEF9F6; padding: 0 16px; height: 52px">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="#121212" stroke-width="1"><circle cx="7.5" cy="7.5" r="6"></circle><path d="M12 12l5 5"></path></svg>
          <input id="site-search" type="search" name="q" autocomplete="off" placeholder="Search {{ shop.name | escape }}" data-search-input style="flex: 1 1 auto; min-width: 0; height: 50px; border: 0; background: transparent; font-size: 16px; color: #121212; outline: none">
          <input type="hidden" name="type" value="product">
        </div>
        <button type="button" data-close-search aria-label="Close search" style="width: 44px; height: 44px; padding: 0; background: none; border: 0; cursor: pointer; display: inline-flex; align-items: center; justify-content: center"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#121212" stroke-width="1.2"><path d="M1 1l14 14M15 1L1 15"></path></svg></button>
      </div>
      <p data-search-heading style="margin: 0; font-size: 12px; line-height: 16.8px; text-transform: uppercase">Popular products</p>
      <div data-search-results style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 14px">
        {%- for p in collections.all.products limit: 4 -%}
          {% render 'search-result', product: p %}
        {%- endfor -%}
      </div>
    </form>
  </div>
</div>
