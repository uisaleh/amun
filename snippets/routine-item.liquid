{%- liquid
  capture nm
    render 'amun-data', handle: product.handle, key: 'name'
  endcapture
  capture img
    render 'amun-data', handle: product.handle, key: 'card_img'
  endcapture
  capture ddesc
    render 'amun-data', handle: product.handle, key: 'card_desc'
  endcapture
  assign rv = product.selected_or_first_available_variant
-%}
<div style="display: flex; gap: 24px; align-items: center; padding-bottom: 14px; border-bottom: 1px solid #000000">
  <a href="{{ product.url }}" aria-label="View {{ nm | default: product.title | escape }}" style="position: relative; flex: 0 0 120px; aspect-ratio: 1 / 1; background: #e3e3df; display: block; overflow: hidden">
    {%- if settings.use_design_images and img != blank -%}
      <img width="1200" height="1200" {% render 'asset-src', file: img, sizes: '240px' %} alt="" loading="lazy" data-card-img style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover">
    {%- elsif product.featured_media -%}
      {{ product.featured_media | image_url: width: 300 | image_tag: alt: '', loading: 'lazy', data-card-img: '', style: 'position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover' }}
    {%- endif -%}
  </a>
  <div style="flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 6px">
    <a href="{{ product.url }}" style="font-size: 14px; line-height: 19.6px">{% if nm != blank %}{{ nm | escape }}{% else %}{% render 'title-case', text: product.title %}{% endif %}</a>
    <span style="font-size: 12px; line-height: 16.8px">{{ ddesc | default: product.description | newline_to_br | replace: '</', ' </' | replace: '<br', ' <br' | strip_html | replace: '  ', ' ' | replace: '  ', ' ' | strip | truncatewords: 20 | escape }}</span>
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-top: 6px">
      {%- if product.available -%}
        <button type="button" class="atc" data-add="{{ rv.id }}" style="height: 44px; padding: 0 20px; border: 1px solid #000000; border-radius: 0; background: #ffffff; color: #000000; font-size: 12px; cursor: pointer">Add to Cart - {{ rv.price | money_without_trailing_zeros }}</button>
      {%- endif -%}
      <a href="{{ product.url }}" style="font-size: 12px; line-height: 16.8px; text-decoration: underline">View Product</a>
    </div>
  </div>
</div>
