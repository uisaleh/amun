{%- capture img -%}{% render 'amun-data', handle: product.handle, key: 'card_img' %}{%- endcapture -%}
{%- capture nm -%}{% render 'amun-data', handle: product.handle, key: 'name' %}{%- endcapture -%}
<a href="{{ product.url }}" style="display: flex; align-items: center; gap: 14px; padding: 10px; background: #FEF9F6; text-decoration: none">
  {%- if settings.use_design_images and img != blank -%}
    <img width="1200" height="1200" src="{{ img | asset_url }}" alt="" loading="lazy" style="flex: 0 0 56px; width: 56px; height: 70px; object-fit: cover; background: #efefea">
  {%- elsif product.featured_image -%}
    {{ product.featured_image | image_url: width: 120 | image_tag: alt: '', loading: 'lazy', style: 'flex: 0 0 56px; width: 56px; height: 70px; object-fit: cover; background: #efefea' }}
  {%- endif -%}
  <span style="display: flex; flex-direction: column; gap: 4px; min-width: 0"><span style="font-size: 14px; line-height: 19.6px">{% if nm != blank %}{{ nm | escape }}{% else %}{% render 'title-case', text: product.title %}{% endif %}</span><span style="font-size: 12px; line-height: 16.8px">{{ product.price | money }}</span></span>
</a>
