<div class="overlay" data-cart hidden>
  <div class="overlay__bg" data-close-cart aria-hidden="true"></div>
  <aside class="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="cart-h">
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid #121212">
      <h2 id="cart-h" style="margin: 0; font-size: 18px; line-height: 25.2px">Your Cart (<span data-cart-count>{{ cart.item_count }}</span>)</h2>
      <button type="button" data-close-cart aria-label="Close cart" style="width: 44px; height: 44px; padding: 0; background: none; border: 0; cursor: pointer; display: inline-flex; align-items: center; justify-content: center"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#121212" stroke-width="1.2"><path d="M1 1l14 14M15 1L1 15"></path></svg></button>
    </div>
    <div style="padding: 18px 24px; border-bottom: 1px solid #121212; display: flex; flex-direction: column; gap: 10px">
      <p data-ship-msg style="margin: 0; font-size: 12px; line-height: 16.8px"></p>
      <div aria-hidden="true" style="height: 4px; background: #DFDDD0"><div data-ship-bar style="height: 4px; width: 0; background: #585128; transition: width 300ms ease"></div></div>
    </div>
    <div data-cart-body style="flex: 1 0 auto; padding: 0 24px"></div>
    <div data-cart-foot hidden style="padding: 24px; border-top: 1px solid #121212; display: flex; flex-direction: column; gap: 14px">
      <fieldset style="margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: 8px; min-width: 0">
        <legend style="padding: 0; margin-bottom: 8px; font-size: 12px; line-height: 16.8px; text-transform: uppercase">Shipping method</legend>
        <div data-ship-opts style="display: flex; flex-direction: column; gap: 8px"></div>
        <p style="margin: 0; font-size: 11px; line-height: 15.4px; color: #4a4a40">Choose your final shipping method at checkout.</p>
      </fieldset>
      <form data-code-form style="display: flex; flex-direction: column; gap: 6px; margin: 0">
        <label for="cart-code" style="font-size: 12px; line-height: 16.8px; text-transform: uppercase">Discount code</label>
        <div style="display: flex; gap: 8px"><input id="cart-code" name="code" type="text" autocomplete="off" placeholder="Enter discount code" style="flex: 1 1 auto; min-width: 0; height: 44px; padding: 0 12px; border: 1px solid rgba(18, 18, 18, 0.4); border-radius: 0; background: #ffffff; color: #121212; font-size: 13px"><button type="submit" style="flex: 0 0 auto; height: 44px; padding: 0 18px; background: #ffffff; color: #121212; border: 1px solid #121212; border-radius: 0; font-size: 13px; cursor: pointer">Apply</button></div>
        <p class="form-msg form-msg--error" role="alert" data-code-error hidden></p>
      </form>
      <div style="display: flex; flex-direction: column; gap: 6px">
        <div style="display: flex; justify-content: space-between; font-size: 14px; line-height: 19.6px"><span>Subtotal</span><span data-subtotal></span></div>
        <div style="display: flex; justify-content: space-between; font-size: 14px; line-height: 19.6px"><span>Shipping · <span data-ship-name></span></span><span data-ship-price></span></div>
        <div data-discount-row hidden style="display: flex; justify-content: space-between; align-items: center; font-size: 14px; line-height: 19.6px"><span>Discount · <span data-discount-code></span> <button type="button" class="link-btn" data-remove-code style="margin-left: 6px">Remove</button></span><span data-discount-amt></span></div>
        <div style="display: flex; justify-content: space-between; font-size: 16px; line-height: 22.4px; padding-top: 6px; border-top: 1px solid rgba(18, 18, 18, 0.15)"><span>Estimated total</span><span data-total></span></div>
      </div>
      <p style="margin: 0; font-size: 12px; line-height: 16.8px">Taxes calculated at checkout. Or 4 interest-free payments of <span data-klarna></span> with <strong style="font-weight: 700">Klarna.</strong></p>
      <a href="{{ routes.root_url }}checkout" data-checkout class="atc-dark" style="display: flex; align-items: center; justify-content: center; height: 52px; background: #585128; color: #ffffff; border: 1px solid #585128; border-radius: 0; font-size: 14px; text-decoration: none">Checkout</a>
      <a href="{{ routes.all_products_collection_url }}" class="link-btn" style="align-self: center">Continue shopping</a>
    </div>
  </aside>
</div>
