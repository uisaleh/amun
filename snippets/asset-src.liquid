{%- comment -%}Outputs src/srcset for a built-in design photo using the optimised WebP copies. Param: file (e.g. amun-xxxx.jpg), sizes (optional){%- endcomment -%}
{%- assign base = file | split: '.' | first -%}
{%- if file contains 'amun-logo' or file contains 'amun-icon' or file contains 'amun-mark' or file contains 'favicon' -%}
src="{{ file | asset_url }}"
{%- else -%}
src="{{ base | append: '-1600.webp' | asset_url }}" srcset="{{ base | append: '-800.webp' | asset_url }} 800w, {{ base | append: '-1600.webp' | asset_url }} 1600w" sizes="{{ sizes | default: '100vw' }}"
{%- endif -%}
