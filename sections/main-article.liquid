{%- assign words = article.content | strip_html | split: ' ' | size -%}
{%- assign minutes = words | divided_by: 200 | at_least: 1 -%}
<section style="padding: 42px 24px 60px">
  <div style="max-width: 1300px; margin: 0 auto"><a href="{{ blog.url }}" style="display: inline-flex; align-items: center; gap: 10px; font-size: 12px; line-height: 16.8px"><svg aria-hidden="true" width="16" height="10" viewBox="0 0 16 10" fill="none" stroke="#000" stroke-width="1"><path d="M15 5H1M5 1L1 5l4 4"></path></svg>Back to {{ section.settings.blog_name | default: blog.title | escape }}</a></div>
  <div style="max-width: 760px; margin: 42px auto 0; display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center">
    <p style="margin: 0; font-size: 12px; line-height: 16.8px">{% if article.tags.first %}{{ article.tags.first | escape }} · {% endif %}{{ minutes }} min read</p>
    <h1 style="margin: 0; font-size: 34px; line-height: 40px">{{ article.title | escape }}</h1>
    {%- if article.excerpt != blank -%}<p style="margin: 0; font-size: 20px; line-height: 28px; font-weight: 300">{{ article.excerpt | strip_html }}</p>{%- endif -%}
    <p style="margin: 0; font-size: 12px; line-height: 16.8px">{{ article.published_at | date: '%B %-d, %Y' }}{% if article.author != blank %} · By {{ article.author | escape }}{% endif %}</p>
  </div>
</section>
{%- if article.image -%}
  {{ article.image | image_url: width: 2000 | image_tag: alt: article.image.alt, style: 'display: block; width: 100%; height: 720px; object-fit: cover; object-position: center 40%; background: #8a9a6a', sizes: '100vw' }}
{%- endif -%}
<article style="padding: 72px 24px">
  <div class="rte" style="max-width: 680px; margin: 0 auto">{{ article.content }}</div>
</article>
{%- if section.settings.products != blank -%}
  <section aria-labelledby="shop-h" style="padding: 72px 24px; background: #DFDDD0">
    <div style="max-width: 1180px; margin: 0 auto; display: flex; flex-direction: column; gap: 42px">
      <div class="sec-head" style="margin: 0"><h2 id="shop-h">{{ section.settings.shop_heading | escape }}</h2><p>{{ section.settings.shop_text | escape }}</p></div>
      <div style="display: flex; flex-wrap: wrap; gap: 24px">
        {%- for p in section.settings.products -%}<div style="flex: 1 1 260px; display: flex">{% render 'product-card', product: p %}</div>{%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "text", "id": "blog_name", "label": "Back link name", "default": "The Journal" },
    { "type": "text", "id": "shop_heading", "label": "Products heading", "default": "Shop the Story" },
    { "type": "text", "id": "shop_text", "label": "Products text", "default": "The tallow formulas mentioned in this post." },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 4 }
  ]
}
{% endschema %}
