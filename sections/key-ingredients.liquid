{%- liquid
  assign h = product.handle
  capture ings
    render 'amun-data', handle: h, key: 'ings'
  endcapture
  capture bg
    render 'amun-data', handle: h, key: 'ing_bg'
  endcapture
  capture intro
    render 'amun-data', handle: h, key: 'ing_intro'
  endcapture
-%}
{%- if ings != blank -%}
{%- assign list = ings | split: '~~' -%}
{%- assign bgf = bg | split: '^^' -%}
{%- assign intro_p = intro | split: '~~' -%}
<section aria-labelledby="ing-h" data-ings style="position: relative; overflow: hidden; background: #2b2b22; color: #ffffff; padding: 96px 24px">
  {%- if bgf[0] != blank -%}<img width="1200" height="1200" src="{{ bgf[0] | asset_url }}" alt="" loading="lazy" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: {{ bgf[1] | default: 'center' }}">{%- endif -%}
  <div aria-hidden="true" style="position: absolute; inset: 0; background: rgba(0, 0, 0, 0.6)"></div>
  <div style="position: relative; max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 42px">
    {%- if intro != blank -%}
      <div style="display: flex; flex-direction: column; gap: 6px"><p style="margin: 0; font-size: 20px; line-height: 28px; font-weight: 300">{{ intro_p[0] | escape }}</p>{% if intro_p[1] %}<p style="margin: 0; font-size: 14px; line-height: 19.6px">{{ intro_p[1] | escape }}</p>{% endif %}</div>
    {%- endif -%}
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; border-bottom: 1px solid #ffffff">
      <h2 id="ing-h" style="margin: 0 0 14px; font-size: 23px; line-height: 32.2px">{{ section.settings.heading | escape }}</h2>
      <div role="tablist" aria-label="Key ingredients" style="display: flex; flex-wrap: wrap; gap: 0 24px">
        {%- for it in list -%}
          {%- assign f = it | split: '^^' -%}
          <button type="button" role="tab" class="ing-tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-ing-tab="{{ forloop.index0 }}">{{ f[0] | escape }}</button>
        {%- endfor -%}
      </div>
    </div>
    {%- for it in list -%}
      {%- assign f = it | split: '^^' -%}
      <div role="tabpanel" data-ing-panel="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %} style="display: flex; flex-wrap: wrap; align-items: center; gap: 42px 72px">
        <img width="1200" height="1200" src="{{ f[1] | asset_url }}" alt="{{ f[2] | escape }}" loading="lazy" style="flex: 0 1 380px; min-width: 0; width: 100%; max-width: 380px; aspect-ratio: 1 / 1; object-fit: cover; display: block; margin: 0 auto; height: auto">
        <div style="flex: 1 1 380px; display: flex; flex-direction: column; gap: 14px">
          <p style="margin: 0; font-size: 12px; line-height: 16.8px">{{ forloop.index }} / {{ forloop.length }}</p>
          <h3 style="margin: 0; font-size: 23px; line-height: 32.2px">{{ f[0] | escape }}</h3>
          <p style="margin: 0; font-size: 16px; line-height: 25.6px; max-width: 480px">{{ f[3] | escape }}</p>
          <div style="display: flex; gap: 10px; margin-top: 14px">
            <button type="button" aria-label="Previous ingredient" data-ing-prev style="width: 44px; height: 44px; border: 1px solid #ffffff; border-radius: 0; background: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center"><svg aria-hidden="true" width="16" height="10" viewBox="0 0 16 10" fill="none" stroke="#ffffff" stroke-width="1"><path d="M15 5H1M5 1L1 5l4 4"></path></svg></button>
            <button type="button" aria-label="Next ingredient" data-ing-next style="width: 44px; height: 44px; border: 1px solid #ffffff; border-radius: 0; background: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center"><svg aria-hidden="true" width="16" height="10" viewBox="0 0 16 10" fill="none" stroke="#ffffff" stroke-width="1"><path d="M1 5h14M11 1l4 4-4 4"></path></svg></button>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Key ingredients",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Key Ingredients" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
