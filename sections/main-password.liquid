<main style="min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; padding: 48px 24px; text-align: center">
  <img src="{{ 'amun-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="160" height="41">
  <h1 style="margin: 0; font-size: 28px">{{ shop.password_message | default: 'Opening soon' | escape }}</h1>
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: center">
      <label for="pw" class="visually-hidden">Password</label>
      <input id="pw" type="password" name="password" placeholder="Store password" style="height: 48px; padding: 0 14px; border: 1px solid #121212; border-radius: 0; background: #fff">
      <button type="submit" class="atc-dark" style="height: 48px; padding: 0 24px; background: #585128; color: #fff; border: 1px solid #585128; border-radius: 0; cursor: pointer">Enter</button>
    </div>
  {%- endform -%}
</main>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
