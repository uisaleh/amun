{%- liquid
  assign list = section.settings.products
  if list == blank and section.settings.collection != blank
    assign list = section.settings.collection.products
  endif
  if list == blank
    assign list = collections.all.products
  endif
-%}
<section aria-labelledby="ps-h-{{ section.id }}" style="padding: {{ section.settings.pad_top }}px 24px {{ section.settings.pad_bottom }}px">
  <div class="sec-head">
    {%- if section.settings.show_icon -%}{% render 'icon-logo' %}{%- endif -%}
    <h2 id="ps-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
  </div>
  <div class="slider" data-slider>
    <button type="button" class="slider__arrow slider__arrow--prev" aria-label="Previous products" data-slider-prev><svg aria-hidden="true" width="14" height="28" viewBox="0 0 14 28" fill="none" stroke="#000" stroke-width="1"><path d="M13 1L1 14l12 13"></path></svg></button>
    <div class="slider__view" data-slider-view>
      <div class="slider__track">
        {%- for p in list limit: 16 -%}
          {% render 'product-card', product: p, strike: section.settings.strike %}
        {%- endfor -%}
      </div>
    </div>
    <button type="button" class="slider__arrow slider__arrow--next" aria-label="Next products" data-slider-next><svg aria-hidden="true" width="14" height="28" viewBox="0 0 14 28" fill="none" stroke="#000" stroke-width="1"><path d="M1 1l12 13L1 27"></path></svg></button>
  </div>
</section>

{% schema %}
{
  "name": "Product slider",
  "settings": [
    { "type": "checkbox", "id": "show_icon", "label": "Show icon logo above title", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Amun Collection" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Our everyday essentials, designed to bring your hair, skin, and health back to harmony" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 16 },
    { "type": "collection", "id": "collection", "label": "Or a collection", "info": "Used when no products are picked." },
    { "type": "checkbox", "id": "strike", "label": "Show crossed-out compare price", "default": false },
    { "type": "range", "id": "pad_top", "label": "Top space", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom space", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Product slider" }]
}
{% endschema %}
