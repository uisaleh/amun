{%- if section.settings.layout == 'split' -%}
<section class="hero-split" aria-labelledby="hero-h-{{ section.id }}" style="--hero-bg: {{ section.settings.bg }}; position: relative; overflow: hidden; background: var(--hero-bg); color: #ffffff">
  <div class="hero-split__media">
    {% render 'amun-image', image: section.settings.image, fallback: section.settings.fallback, alt: section.settings.alt, loading: 'eager', style: 'position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center center', sizes: '(min-width: 1101px) 66vw, 100vw' %}
    <span class="hero-split__fade" aria-hidden="true"></span>
  </div>
  <div class="hero-split__copy">
    {%- if section.settings.eyebrow != blank -%}<p style="margin: 0; font-size: 13px; line-height: 18px; letter-spacing: 2.4px; text-transform: uppercase">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1 id="hero-h-{{ section.id }}" style="margin: 0; font-size: 34px; line-height: 42px; max-width: 420px; text-wrap: balance">{{ section.settings.heading | escape }}</h1>
    <p style="margin: 0; font-size: 16px; line-height: 24px; max-width: 380px">{{ section.settings.text | escape }}</p>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="hero-btn" style="margin-top: 10px; display: inline-flex; align-items: center; justify-content: center; height: 50px; min-width: 200px; padding: 0 24px; border: 1px solid #ffffff; color: #ffffff; font-size: 14px">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>
{%- else -%}
<section class="hero" aria-labelledby="hero-h-{{ section.id }}" style="position: relative; overflow: hidden; background: #7d8a5c; min-height: 680px; display: flex; flex-wrap: wrap; align-items: center">
  {% render 'amun-image', image: section.settings.image, fallback: section.settings.fallback, alt: section.settings.alt, loading: 'eager', style: 'position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 20% center', sizes: '100vw' %}
  <span class="hero-ov" aria-hidden="true" style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0, 0, 0, 0) 35%, rgba(0, 0, 0, 0.35) 100%)"></span>
  <div class="hero-sp" style="position: relative; flex: 1 1 480px; min-height: 1px"></div>
  <div class="hero-copy" style="position: relative; flex: 1 1 480px; display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 60px 24px; text-align: center; color: #ffffff">
    {%- if section.settings.eyebrow != blank -%}<p style="margin: 0; font-size: 13px; line-height: 18px; letter-spacing: 2.4px; text-transform: uppercase">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1 id="hero-h-{{ section.id }}" style="margin: 0; font-size: 34px; line-height: 42px; max-width: 560px; text-wrap: balance">{{ section.settings.heading | escape }}</h1>
    <p style="margin: 0; font-size: 16px; line-height: 24px; max-width: 420px">{{ section.settings.text | escape }}</p>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="hero-btn" style="margin-top: 10px; display: inline-flex; align-items: center; justify-content: center; height: 50px; min-width: 200px; padding: 0 24px; border: 1px solid #ffffff; color: #ffffff; font-size: 14px">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "overlay", "options": [ { "value": "overlay", "label": "Text over photo" }, { "value": "split", "label": "Text beside photo (product shot)" } ] },
    { "type": "color", "id": "bg", "label": "Background colour (beside photo)", "default": "#3B141C" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback", "label": "Built-in design photo", "default": "amun-fb28d4cdcc.jpg", "info": "Used when no image is picked." },
    { "type": "text", "id": "alt", "label": "Image description", "default": "A woman in a meadow holding an AMUN bottle on her shoulder, with an AMUN gift bag on her arm" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "REDEFINING HAIR HEALTH." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ancient technology. Modern vitality." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Professional-grade holistic hair & skin care using nature’s finest ingredients to nourish you and the land." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "/collections/all" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
