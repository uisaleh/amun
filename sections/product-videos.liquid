{%- capture vids -%}{% render 'amun-data', handle: product.handle, key: 'videos' %}{%- endcapture -%}
{%- if section.blocks.size > 0 or vids != blank -%}
<section aria-labelledby="onyou-h" style="padding: 72px 24px 72px">
  <h2 id="onyou-h" style="margin: 0 0 42px; font-size: 23px; line-height: 23px; text-align: center">{{ section.settings.heading | escape }}</h2>
  {%- assign items = vids | split: '~~' -%}
  {% render 'video-slider', blocks: section.blocks, items: items, max: 1240, item_w: 290 %}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product videos",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Amun on You" }],
  "blocks": [
    { "type": "video", "name": "Video", "settings": [
      { "type": "video", "id": "video", "label": "Video (upload to Shopify)" },
      { "type": "text", "id": "video_url", "label": "Or video file / link" },
      { "type": "text", "id": "label", "label": "Caption" }
    ] }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
