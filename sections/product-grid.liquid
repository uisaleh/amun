{%- liquid
  assign list = section.settings.products
  if list == blank and section.settings.collection != blank
    assign list = section.settings.collection.products
  endif
  if list == blank
    assign list = collections.all.products
  endif
-%}
<section aria-labelledby="pg-h-{{ section.id }}" style="padding: 72px 24px 64px">
  <div class="sec-head">
    {%- if section.settings.show_icon -%}{% render 'icon-logo' %}{%- endif -%}
    <h2 id="pg-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
  </div>
  <div style="max-width: 1180px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 24px">
    {%- for p in list limit: section.settings.limit -%}
      <div style="flex: 1 1 260px; display: flex">{% render 'product-card', product: p %}</div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "checkbox", "id": "show_icon", "label": "Show icon logo above title", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop Best Sellers" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A new kind of haircare: clean tallow formulas that restore your hair's balance so it looks — and feels — its best all the time." },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "collection", "id": "collection", "label": "Or a collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 1, "max": 12, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
