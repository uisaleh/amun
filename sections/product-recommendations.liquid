{%- capture recs -%}{% render 'amun-data', handle: product.handle, key: 'recs' %}{%- endcapture -%}
<section aria-labelledby="rec-h" style="padding: 0 24px 72px" {% if recs == blank %}data-recs-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4"{% endif %}>
  <h2 id="rec-h" style="margin: 0 0 42px; font-size: 23px; line-height: 23px; text-align: center">{{ section.settings.heading | escape }}</h2>
  <div class="slider" data-slider>
    <button type="button" class="slider__arrow slider__arrow--prev" aria-label="Previous products" data-slider-prev><svg aria-hidden="true" width="14" height="28" viewBox="0 0 14 28" fill="none" stroke="#000" stroke-width="1"><path d="M13 1L1 14l12 13"></path></svg></button>
    <div class="slider__view" data-slider-view>
      <div class="slider__track">
        {%- if recs != blank -%}
          {%- assign items = recs | split: '~~' -%}
          {%- for rh in items -%}
            {%- assign rp = all_products[rh] -%}
            {%- if rp != blank and rp.id -%}{% render 'product-card', product: rp, strike: true %}{%- endif -%}
          {%- endfor -%}
        {%- elsif recommendations.performed -%}
          {%- for rp in recommendations.products -%}{% render 'product-card', product: rp, strike: true %}{%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    <button type="button" class="slider__arrow slider__arrow--next" aria-label="Next products" data-slider-next><svg aria-hidden="true" width="14" height="28" viewBox="0 0 14 28" fill="none" stroke="#000" stroke-width="1"><path d="M1 1l12 13L1 27"></path></svg></button>
  </div>
</section>

{% schema %}
{
  "name": "Recommendations",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "May We Recommend?" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
