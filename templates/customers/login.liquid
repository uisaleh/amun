<style>#recover:not(:target){display:none}#recover:target{display:flex!important}#recover:target+#login{display:none!important}</style>
<section style="padding: 84px 24px 96px">
  <div style="max-width: 480px; margin: 0 auto; display: flex; flex-direction: column; gap: 30px">
    <div id="recover" style="flex-direction: column; gap: 30px">
      <div style="display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center">
      <h1 style="margin: 0; font-size: 34px; line-height: 40px">Reset Your Password</h1>
      <p style="margin: 0; font-size: 16px; line-height: 22.4px">We’ll email you a link to set a new password.</p>
    </div>
      {%- form 'recover_customer_password' -%}
      <div style="display: flex; flex-direction: column; gap: 22px">
        {%- if form.posted_successfully? -%}<p role="status" style="margin: 0; padding: 14px; background: #DFDDD0; font-size: 14px; line-height: 19.6px">We’ve sent you an email with a link to update your password.</p>{%- endif -%}
        {%- if form.errors -%}<div role="alert" style="font-size: 14px; line-height: 19.6px; color: #8a1c1c">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label style="display: flex; flex-direction: column; gap: 8px; font-size: 12px; line-height: 16.8px">Email<input name="email" type="email" autocomplete="email" placeholder="Email" required style="height: 52px; padding: 0 18px; border: 1px solid #121212; border-radius: 0; background: #ffffff; color: #121212; font-size: 14px; width: 100%"></label>
        <button type="submit" class="atc-dark" style="height: 52px; background: #585128; color: #ffffff; border: 1px solid #585128; border-radius: 0; font-size: 14px; cursor: pointer">Send Reset Link</button>
        <a href="#login" style="padding: 0; font-size: 12px; line-height: 19.6px; color: #121212; text-decoration: underline; align-self: flex-start">Back to sign in</a>
      </div>
      {%- endform -%}
    </div>
    <div id="login" style="display: flex; flex-direction: column; gap: 30px">
      <div style="display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center">
      <h1 style="margin: 0; font-size: 34px; line-height: 40px">Login</h1>
      <p style="margin: 0; font-size: 16px; line-height: 22.4px">Sign in to track orders and manage your subscriptions.</p>
    </div>
      {%- form 'customer_login' -%}
      <div style="display: flex; flex-direction: column; gap: 22px">
        {%- if form.errors -%}<div role="alert" style="font-size: 14px; line-height: 19.6px; color: #8a1c1c">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label style="display: flex; flex-direction: column; gap: 8px; font-size: 12px; line-height: 16.8px">Email<input name="customer[email]" type="email" autocomplete="email" placeholder="Email" required style="height: 52px; padding: 0 18px; border: 1px solid #121212; border-radius: 0; background: #ffffff; color: #121212; font-size: 14px; width: 100%"></label>
        <label style="display: flex; flex-direction: column; gap: 8px; font-size: 12px; line-height: 16.8px">Password<input name="customer[password]" type="password" autocomplete="current-password" placeholder="Password" required style="height: 52px; padding: 0 18px; border: 1px solid #121212; border-radius: 0; background: #ffffff; color: #121212; font-size: 14px; width: 100%"></label>
        <a href="#recover" style="padding: 0; font-size: 12px; line-height: 19.6px; color: #121212; text-decoration: underline; align-self: flex-start">Forgot your password?</a>
        <button type="submit" class="atc-dark" style="height: 52px; background: #585128; color: #ffffff; border: 1px solid #585128; border-radius: 0; font-size: 14px; cursor: pointer">Sign In</button>
      </div>
      {%- endform -%}
      <p style="margin: 0; text-align: center; font-size: 14px; line-height: 19.6px">New to Amun Organics? <a href="{{ routes.account_register_url }}" style="text-decoration: underline">Create an account</a></p>
      {%- if shop.checkout.guest_login -%}
        {%- form 'guest_login' -%}<button type="submit" style="width: 100%; height: 52px; background: #ffffff; color: #121212; border: 1px solid #121212; border-radius: 0; font-size: 14px; cursor: pointer">Continue as Guest</button>{%- endform -%}
      {%- endif -%}
    </div>
  </div>
</section>
