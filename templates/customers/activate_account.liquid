<section style="max-width: 520px; margin: 0 auto; padding: 72px 24px; display: flex; flex-direction: column; gap: 18px">
  <h1 style="margin: 0; font-size: 34px; line-height: 40px; text-align: center">Activate Account</h1>
  {%- form 'activate_customer_password' -%}
    <div style="display: flex; flex-direction: column; gap: 14px">
      {{ form.errors | default_errors }}
      <input type="password" name="customer[password]" autocomplete="new-password" placeholder="Password" aria-label="Password" style="height: 50px; padding: 0 14px; border: 1px solid #121212; border-radius: 0; background: #fff; font-size: 14px; width: 100%">
      <input type="password" name="customer[password_confirmation]" autocomplete="new-password" placeholder="Confirm password" aria-label="Confirm password" style="height: 50px; padding: 0 14px; border: 1px solid #121212; border-radius: 0; background: #fff; font-size: 14px; width: 100%">
      <button type="submit" class="atc-dark" style="height: 50px; background: #585128; color: #fff; border: 1px solid #585128; border-radius: 0; font-size: 14px; cursor: pointer; width: 100%">Activate</button>
      <button type="submit" name="decline" style="height: 50px; background: #fff; border: 1px solid #121212; border-radius: 0; cursor: pointer">Decline invitation</button>
    </div>
  {%- endform -%}
</section>
