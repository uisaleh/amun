<section style="padding: 84px 24px 96px">
  <div style="max-width: 480px; margin: 0 auto; display: flex; flex-direction: column; gap: 30px">
    <div style="display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center">
      <h1 style="margin: 0; font-size: 34px; line-height: 40px">Activate Account</h1>
      <p style="margin: 0; font-size: 16px; line-height: 22.4px">Create a password to activate your account.</p>
    </div>
    {%- form 'activate_customer_password' -%}
      <div style="display: flex; flex-direction: column; gap: 22px">
        {%- if form.errors -%}<div role="alert" style="font-size: 14px; line-height: 19.6px; color: #8a1c1c">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label style="display: flex; flex-direction: column; gap: 8px; font-size: 12px; line-height: 16.8px">Password<input name="customer[password]" type="password" autocomplete="new-password" placeholder="Password" required style="height: 52px; padding: 0 18px; border: 1px solid #121212; border-radius: 0; background: #ffffff; color: #121212; font-size: 14px; width: 100%"></label>
        <label style="display: flex; flex-direction: column; gap: 8px; font-size: 12px; line-height: 16.8px">Confirm password<input name="customer[password_confirmation]" type="password" autocomplete="new-password" placeholder="Confirm password" required style="height: 52px; padding: 0 18px; border: 1px solid #121212; border-radius: 0; background: #ffffff; color: #121212; font-size: 14px; width: 100%"></label>
        <button type="submit" class="atc-dark" style="height: 52px; background: #585128; color: #ffffff; border: 1px solid #585128; border-radius: 0; font-size: 14px; cursor: pointer">Activate Account</button>
        <button type="submit" name="decline" style="height: 52px; background: #ffffff; color: #121212; border: 1px solid #121212; border-radius: 0; font-size: 14px; cursor: pointer">Decline Invitation</button>
      </div>
    {%- endform -%}
  </div>
</section>
