<section style="max-width: 520px; margin: 0 auto; padding: 72px 24px; display: flex; flex-direction: column; gap: 18px">
  <h1 style="margin: 0; font-size: 34px; line-height: 40px; text-align: center">Create Account</h1>
  {%- form 'create_customer' -%}
    <div style="display: flex; flex-direction: column; gap: 14px">
      {{ form.errors | default_errors }}
      <label for="r-first" class="visually-hidden">First name</label><input id="r-first" type="text" name="customer[first_name]" autocomplete="given-name" placeholder="First name" style="height: 50px; padding: 0 14px; border: 1px solid #121212; border-radius: 0; background: #fff; font-size: 14px; width: 100%">
      <label for="r-last" class="visually-hidden">Last name</label><input id="r-last" type="text" name="customer[last_name]" autocomplete="family-name" placeholder="Last name" style="height: 50px; padding: 0 14px; border: 1px solid #121212; border-radius: 0; background: #fff; font-size: 14px; width: 100%">
      <label for="r-email" class="visually-hidden">Email</label><input id="r-email" type="email" name="customer[email]" autocomplete="email" placeholder="Email" required style="height: 50px; padding: 0 14px; border: 1px solid #121212; border-radius: 0; background: #fff; font-size: 14px; width: 100%">
      <label for="r-pw" class="visually-hidden">Password</label><input id="r-pw" type="password" name="customer[password]" autocomplete="new-password" placeholder="Password" required style="height: 50px; padding: 0 14px; border: 1px solid #121212; border-radius: 0; background: #fff; font-size: 14px; width: 100%">
      <label style="display: flex; gap: 10px; align-items: center; font-size: 12px"><input type="checkbox" name="customer[accepts_marketing]" value="true"> Email me new formulas and offers</label>
      <button type="submit" class="atc-dark" style="height: 50px; background: #585128; color: #fff; border: 1px solid #585128; border-radius: 0; font-size: 14px; cursor: pointer; width: 100%">Create</button>
    </div>
  {%- endform -%}
</section>
