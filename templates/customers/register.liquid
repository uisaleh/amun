<section style="padding: 84px 24px 96px">
  <div style="max-width: 480px; margin: 0 auto; display: flex; flex-direction: column; gap: 30px">
    <div style="display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center">
      <h1 style="margin: 0; font-size: 34px; line-height: 40px">Create Account</h1>
      <p style="margin: 0; font-size: 16px; line-height: 22.4px">Join Amun Organics to track orders and manage your subscriptions.</p>
    </div>
    {%- form 'create_customer' -%}
      <div style="display: flex; flex-direction: column; gap: 22px">
        {%- if form.errors -%}<div role="alert" style="font-size: 14px; line-height: 19.6px; color: #8a1c1c">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label style="display: flex; flex-direction: column; gap: 8px; font-size: 12px; line-height: 16.8px">First name<input name="customer[first_name]" type="text" autocomplete="given-name" placeholder="First name" style="height: 52px; padding: 0 18px; border: 1px solid #121212; border-radius: 0; background: #ffffff; color: #121212; font-size: 14px; width: 100%"></label>
        <label style="display: flex; flex-direction: column; gap: 8px; font-size: 12px; line-height: 16.8px">Last name<input name="customer[last_name]" type="text" autocomplete="family-name" placeholder="Last name" style="height: 52px; padding: 0 18px; border: 1px solid #121212; border-radius: 0; background: #ffffff; color: #121212; font-size: 14px; width: 100%"></label>
        <label style="display: flex; flex-direction: column; gap: 8px; font-size: 12px; line-height: 16.8px">Email<input name="customer[email]" type="email" autocomplete="email" placeholder="Email" required style="height: 52px; padding: 0 18px; border: 1px solid #121212; border-radius: 0; background: #ffffff; color: #121212; font-size: 14px; width: 100%"></label>
        <label style="display: flex; flex-direction: column; gap: 8px; font-size: 12px; line-height: 16.8px">Password<input name="customer[password]" type="password" autocomplete="new-password" placeholder="Password" required style="height: 52px; padding: 0 18px; border: 1px solid #121212; border-radius: 0; background: #ffffff; color: #121212; font-size: 14px; width: 100%"></label>
        <label style="display: flex; gap: 10px; align-items: center; font-size: 12px; line-height: 16.8px; cursor: pointer"><input type="checkbox" name="customer[accepts_marketing]" value="true" style="width: 16px; height: 16px; margin: 0; accent-color: #585128"> Email me new formulas, rituals and offers</label>
        <button type="submit" class="atc-dark" style="height: 52px; background: #585128; color: #ffffff; border: 1px solid #585128; border-radius: 0; font-size: 14px; cursor: pointer">Create Account</button>
      </div>
    {%- endform -%}
    <p style="margin: 0; text-align: center; font-size: 14px; line-height: 19.6px">Already have an account? <a href="{{ routes.account_login_url }}" style="text-decoration: underline">Sign in</a></p>
  </div>
</section>
